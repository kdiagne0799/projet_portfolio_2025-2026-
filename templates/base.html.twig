<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Mon site professionnel{% endblock %}</title>

    <!-- Typo plus sobre -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Icônes -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Favicon simple -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'><circle cx='64' cy='64' r='56' fill='%230F172A'/><text x='50%' y='55%' text-anchor='middle' fill='%23F97316' font-size='60' font-family='sans-serif'>K</text></svg>">

    {% block stylesheets %}{% endblock %}

    <style>
            .welcome-strip {
            margin-top: 1.8rem;
            margin-bottom: 1.4rem;
            background: rgba(15, 23, 42, 0.96);
            border-radius: 18px;
            border: 1px solid rgba(148, 163, 184, 0.4);
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.9);
            padding: 1.2rem 1.4rem;
        }

        .welcome-text h2 {
            margin: 0 0 0.4rem;
            font-size: 1.4rem;
        }

        .welcome-text p {
            margin: 0;
            font-size: 0.95rem;
            color: var(--text-muted);
            max-width: 40rem;
        }

        .welcome-kicker {
            display: inline-block;
            margin-bottom: 0.35rem;
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--accent);
        }

        :root {
            --bg-main: #020617;
            --bg-elevated: rgba(15, 23, 42, 0.85);
            --accent: #f97316;
            --accent-soft: rgba(249, 115, 22, 0.15);
            --text-main: #e5e7eb;
            --text-muted: #9ca3af;
            --border-subtle: rgba(148, 163, 184, 0.3);
            --shadow-soft: 0 18px 45px rgba(15, 23, 42, 0.65);
            --radius-lg: 18px;
            --radius-pill: 999px;
            --transition-fast: 0.18s ease-out;
            --transition-slow: 0.4s ease;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            background:
                radial-gradient(circle at 0% 0%, rgba(249, 115, 22, 0.16), transparent 55%),
                radial-gradient(circle at 100% 100%, rgba(56, 189, 248, 0.18), transparent 60%),
                var(--bg-main);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
        }

        /* Conteneur global */
        .layout-shell {
            max-width: 1120px;
            width: 100%;
            margin: 0 auto;
            padding: 0 1.5rem 2rem;
        }

        /* NAVBAR STICKY / GLASSMORPHISM */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 40;
            backdrop-filter: blur(18px);
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.8) 60%, transparent);
        }

        .nav-shell {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0.9rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            background: radial-gradient(circle at 0 0, #f97316, #be123c);
            position: relative;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.95);
        }

        .brand-logo::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% -10%, rgba(248, 250, 252, 0.8), transparent 60%);
            mix-blend-mode: screen;
        }

        .brand-text-main {
            font-weight: 600;
            letter-spacing: 0.04em;
            font-size: 1rem;
        }

        .brand-text-sub {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .nav-links {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .nav-link {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.55rem 1.25rem;
            border-radius: var(--radius-pill);
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            color: var(--text-muted);
            border: 1px solid transparent;
            background: transparent;
            transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
        }

        .nav-link::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            border: 1px solid rgba(148, 163, 184, 0.2);
            opacity: 0;
            transition: opacity var(--transition-fast);
        }

        .nav-link:hover {
            color: var(--text-main);
            background: var(--accent-soft);
            transform: translateY(-1px);
        }

        .nav-link:hover::after {
            opacity: 1;
        }

        .nav-link-active {
            color: #0f172a;
            background: var(--accent);
            border-color: transparent;
            box-shadow: 0 12px 30px rgba(249, 115, 22, 0.35);
        }

        .nav-link-active::after {
            display: none;
        }

        /* Bouton mode thème */
        .theme-toggle {
            border-radius: var(--radius-pill);
            padding: 0.45rem 0.85rem;
            border: 1px solid var(--border-subtle);
            background: rgba(15, 23, 42, 0.65);
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.8rem;
            cursor: pointer;
            transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
        }

        .theme-toggle:hover {
            background: rgba(15, 23, 42, 0.95);
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-1px);
        }

        /* CONTENU PRINCIPAL */
        main {
            flex: 1;
        }

        .page-hero {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(0, 1.4fr);
            gap: 2.5rem;
            align-items: center;
            padding-top: 1.75rem;
        }

        .hero-text {
            animation: fade-up 0.6s ease-out forwards;
            opacity: 0;
            transform: translateY(12px);
        }

        .hero-kicker {
            font-size: 0.8rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 0.75rem;
        }

        .hero-title {
            font-size: clamp(2.2rem, 4vw, 2.8rem);
            font-weight: 700;
            margin: 0 0 0.75rem;
        }

        .hero-subtitle {
            font-size: 0.96rem;
            color: var(--text-muted);
            max-width: 34rem;
            line-height: 1.6;
            margin-bottom: 1.8rem;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
        }

        .btn-primary {
            border-radius: var(--radius-pill);
            padding: 0.7rem 1.5rem;
            border: none;
            background: linear-gradient(135deg, #f97316, #fb923c);
            color: #0f172a;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 14px 30px rgba(249, 115, 22, 0.4);
            transition: transform var(--transition-fast), box-shadow var(--transition-fast), filter var(--transition-fast);
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            box-shadow: 0 18px 40px rgba(249, 115, 22, 0.55);
        }

        .btn-ghost {
            border-radius: var(--radius-pill);
            padding: 0.7rem 1.3rem;
            border: 1px solid var(--border-subtle);
            background: rgba(15, 23, 42, 0.8);
            color: var(--text-main);
            font-size: 0.86rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
        }

        .btn-ghost:hover {
            background: rgba(15, 23, 42, 1);
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-1px);
        }

        .hero-metadata {
            display: flex;
            gap: 1.5rem;
            margin-top: 1.4rem;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .hero-metadata span {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        /* Carte visuelle à droite */
        .hero-panel {
            position: relative;
            animation: fade-up 0.6s ease-out 0.08s forwards;
            opacity: 0;
            transform: translateY(14px);
        }

        .hero-card {
            background: var(--bg-elevated);
            border-radius: 26px;
            padding: 1.4rem 1.3rem;
            border: 1px solid rgba(148, 163, 184, 0.4);
            box-shadow: var(--shadow-soft);
            position: relative;
            overflow: hidden;
        }

        .hero-card::before {
            content: '';
            position: absolute;
            inset: -40%;
            background:
                radial-gradient(circle at 0 0, rgba(249, 115, 22, 0.13), transparent 60%),
                radial-gradient(circle at 100% 100%, rgba(56, 189, 248, 0.16), transparent 60%);
            opacity: 0.75;
            pointer-events: none;
        }

        .hero-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }

        .hero-chip {
            padding: 0.2rem 0.75rem;
            border-radius: var(--radius-pill);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(148, 163, 184, 0.45);
            color: var(--text-muted);
        }

        .hero-badge {
            padding: 0.25rem 0.7rem;
            border-radius: var(--radius-pill);
            font-size: 0.7rem;
            background: rgba(34, 197, 94, 0.06);
            border: 1px solid rgba(34, 197, 94, 0.35);
            color: #bbf7d0;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .hero-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.8rem;
            margin-bottom: 1.1rem;
            position: relative;
            z-index: 1;
        }

        .metric {
            padding: 0.8rem 0.9rem;
            border-radius: 14px;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(30, 64, 175, 0.55);
            font-size: 0.78rem;
        }

        .metric-label {
            color: var(--text-muted);
            margin-bottom: 0.3rem;
        }

        .metric-value {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .metric-pill {
            margin-top: 0.4rem;
            font-size: 0.7rem;
            padding: 0.15rem 0.55rem;
            border-radius: var(--radius-pill);
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(148, 163, 184, 0.35);
            color: var(--accent);
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }

        .hero-card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.8rem;
            font-size: 0.78rem;
            color: var(--text-muted);
            position: relative;
            z-index: 1;
        }

        .hero-status-dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: #22c55e;
            box-shadow: 0 0 12px rgba(34, 197, 94, 0.8);
        }

        /* SECTION CONTENU TWIG */
        .content-shell {
            margin-top: 2.4rem;
            background: rgba(15, 23, 42, 0.92);
            border-radius: var(--radius-lg);
            border: 1px solid rgba(148, 163, 184, 0.35);
            box-shadow: var(--shadow-soft);
            padding: 1.6rem 1.4rem;
            position: relative;
            overflow: hidden;
        }

        .content-shell::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 0 0, rgba(249, 115, 22, 0.08), transparent 55%);
            opacity: 0.9;
            pointer-events: none;
        }

        .content-inner {
            position: relative;
            z-index: 1;
            animation: fade-in 0.35s ease-out;
        }

        {% block page_styles %}{% endblock %}

    
    </style>
</head>
<body>

<header class="site-header">
    <div class="nav-shell">
        <div class="brand">
            <div class="brand-logo"></div>
            <div>
                <div class="brand-text-main">Khadim Diagne</div>
                <div class="brand-text-sub">Développeur & intégrateur</div>
            </div>
        </div>

        <nav class="nav-links">
            <a href="{{ path('accueil') }}" class="nav-link{% if app.request.get('_route') == 'accueil' %} nav-link-active{% endif %}">
                <i class="bi bi-house-door"></i> Accueil
            </a>
            <a href="{{ path('a_propos') }}" class="nav-link{% if app.request.get('_route') == 'a_propos' %} nav-link-active{% endif %}">
                <i class="bi bi-person"></i> À propos
            </a>
            <a href="{{ path('services') }}" class="nav-link{% if app.request.get('_route') == 'services' %} nav-link-active{% endif %}">
                <i class="bi bi-grid"></i> Services
            </a>
            <a href="{{ path('contact') }}" class="nav-link{% if app.request.get('_route') == 'contact' %} nav-link-active{% endif %}">
                <i class="bi bi-envelope"></i> Contact
            </a>
        </nav>

        <button id="themeToggle" class="theme-toggle">
            <i class="bi bi-moon-stars"></i>
            <span>Mode sombre</span>
        </button>
    </div>
</header>

<main>
    <div class="layout-shell">
        <!-- HERO générique -->
        <section class="page-hero">
        </section>


        </section>

        <!-- Bloc où tes vues enfants injectent leur contenu -->
        <section class="content-shell">
            <div class="content-inner">
                {% block body %}{% endblock %}
            </div>

</main>

<footer class="site-footer">
    <div class="footer-inner">
        <span>&copy; {{ "now"|date("Y") }} Khadim Diagne</span>
        <div class="footer-separator"></div>
        <span><i class="bi bi-shield-lock"></i> Tous droits réservés</span>
        <div class="footer-separator"></div>
        <span><i class="bi bi-github"></i> Code propre & maintenable</span>
    </div>
</footer>

<script>
    // Toggle thème sombre/clair ultra simple (change fond + texte + label bouton)
    const themeToggleBtn = document.getElementById('themeToggle');
    let isLight = false;

    function applyTheme(light) {
        if (light) {
            document.documentElement.style.setProperty('--bg-main', '#768cb8ff');
            document.documentElement.style.setProperty('--bg-elevated', 'rgba(255,255,255,0.96)');
            document.documentElement.style.setProperty('--text-main', '#96b1c9ff');
            document.documentElement.style.setProperty('--text-muted', '#4b5563');
            document.documentElement.style.setProperty('--border-subtle', 'rgba(156, 163, 175, 0.7)');
            themeToggleBtn.querySelector('span').textContent = 'Mode clair';
            themeToggleBtn.querySelector('i').className = 'bi bi-brightness-high';
        } else {
            document.documentElement.style.setProperty('--bg-main', '#070e2eff');
            document.documentElement.style.setProperty('--bg-elevated', 'rgba(15, 23, 42, 0.85)');
            document.documentElement.style.setProperty('--text-main', '#e5e7eb');
            document.documentElement.style.setProperty('--text-muted', '#9ca3af');
            document.documentElement.style.setProperty('--border-subtle', 'rgba(148, 163, 184, 0.3)');
            themeToggleBtn.querySelector('span').textContent = 'Mode sombre';
            themeToggleBtn.querySelector('i').className = 'bi bi-moon-stars';
        }
    }

    themeToggleBtn.addEventListener('click', () => {
        isLight = !isLight;
        applyTheme(isLight);
    });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
