{% extends 'base.html.twig' %}

{% block title %}Accueil – KHADIM DIAGNE{% endblock %}

{% block body %}
        
         <section class="welcome-strip">
            <div class="welcome-text">
                <span class="welcome-kicker">Bonjour et bienvenue</span>
                <h2>Ravi de vous voir ici&nbsp;!</h2>
                <p>
                    Ce site rassemble mon parcours, mes projets et mes compétences en réseaux, systèmes
                    et développement web sécurisé. Explorez les différentes sections pour mieux me découvrir.
                </p>
            </div>
        </section>
<section class="home-grid">
    <!-- Colonne gauche : profil + CV -->
    <div class="home-left">
        <div class="profile-card">
            <div class="profile-avatar-shell">
                <div class="profile-avatar-ring"></div>
                <img src="{{ asset('image/profil.jpg') }}" alt="Photo de profil de KHADIM DIAGNE" class="profile-avatar-img">
            </div>

            <div class="profile-header">
                <h1 class="profile-name">Khadim Diagne</h1>
                <p class="profile-role">Étudiant BUT Réseaux & Télécommunications – Groupe B2</p>
                <p class="profile-location"><i class="bi bi-geo-alt"></i> Roanne · Université Jean-Monnet</p>
            </div>

            <div class="profile-highlight">
                <p>Mastering technologies to build a responsible digital future.</p>
            </div>

            <div class="profile-meta">
                <div class="meta-item">
                    <span class="meta-label">Âge</span>
                    <span class="meta-value">19 ans</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Spécialité</span>
                    <span class="meta-value">Réseaux & Télécom</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Objectif</span>
                    <span class="meta-value">Ingénierie & cybersécurité</span>
                </div>
            </div>

            <div class="profile-actions">
                <button type="button" class="btn-main" onclick="toggleCvPanel()">
                    <i class="bi bi-file-earmark-person"></i>
                    Accéder à mon CV
                </button>
            </div>
        </div>

        <!-- Panneau CV (formulaire + liens) -->
        <div id="cv-panel" class="cv-panel" aria-hidden="true">
            <h2 class="cv-title">Consulter et télécharger mon CV</h2>
            <p class="cv-intro">
                Remplissez ces quelques informations, puis accédez à mon CV en ligne pour l’explorer, le télécharger ou l’imprimer.
            </p>

            <form id="cv-form" class="cv-form" onsubmit="return handleCvForm(event)" autocomplete="off">
                <div class="cv-grid">
                    <div class="field">
                        <label for="firstName">Prénom</label>
                        <input type="text" id="firstName" name="firstName" required>
                    </div>
                    <div class="field">
                        <label for="lastName">Nom</label>
                        <input type="text" id="lastName" name="lastName" required>
                    </div>
                </div>

                <div class="field">
                    <label for="email">Adresse e‑mail</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="field">
                    <label for="address">Ville / Pays</label>
                    <input type="text" id="address" name="address" required>
                </div>

                <div class="field">
                    <label for="profession">Profession / Statut</label>
                    <input type="text" id="profession" name="profession" required>
                </div>

                <div class="cv-actions">
                    <button type="submit" class="btn-main">
                        <i class="bi bi-unlock"></i>
                        Débloquer l’accès au CV
                    </button>
                </div>
            </form>

            <div id="cv-links" class="cv-links" hidden>
                <p class="cv-success">
                    <i class="bi bi-check-circle-fill"></i>
                    Merci ! Vous pouvez maintenant consulter, télécharger ou imprimer mon CV.
                </p>

                <div class="cv-links-buttons">
                    <button type="button" class="btn-outline" onclick="viewMyCV()">
                        <i class="bi bi-window-sidebar"></i>
                        Ouvrir le CV dans un nouvel onglet
                    </button>
                    <a href="{{ asset('cv/cv_Khadim_Diagne.html') }}" class="btn-main" download>
                        <i class="bi bi-download"></i>
                        Télécharger le CV
                    </a>
                    <button type="button" class="btn-ghost-small" onclick="printCV()">
                        <i class="bi bi-printer"></i>
                        Imprimer
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne droite : présentation + compétences + loisirs -->
    <div class="home-right">
        <section class="about-card">
            <h2>Qui suis‑je&nbsp;?</h2>
            <p>
                Étudiant passionné par les systèmes intelligents, l’architecture réseau et le développement web sécurisé,
                je construis des projets qui allient performances techniques et clarté d’usage.
            </p>
            <p>
                Mon objectif : développer des solutions fiables, documentées et maintenables, tout en restant à l’écoute 
                des besoins concrets des utilisateurs.
            </p>
        </section>

        <section class="info-row">
            <div class="info-card">
                <h3>Envies & centre d’intérêt</h3>
                <p>
                    Découvrez mes passions, mes projets personnels et ce qui me motive au quotidien.
                </p>
                <a href="{{ path('loisirs') }}" class="btn-outline">
                    <i class="bi bi-heart-pulse"></i>
                    Voir mes loisirs
                </a>
            </div>

            <div class="info-card">
                <h3>Domaines de compétences</h3>
                <ul class="skills-list">
                    <li><i class="bi bi-terminal"></i> Administration avancée de systèmes Linux</li>
                    <li><i class="bi bi-braces"></i> Python pour l’automatisation & la sécurité</li>
                    <li><i class="bi bi-shield-lock"></i> Développement web sécurisé (Symfony)</li>
                    <li><i class="bi bi-diagram-3"></i> Conception d’architectures réseaux intelligentes</li>
                </ul>
            </div>
        </section>
    </div>
</section></section>

<!-- GRAND CADRE PORTFOLIO PLEINE LARGEUR -->
<section class="portfolio-banner">
    <div class="portfolio-banner-inner">
        <div class="portfolio-banner-text">
            <span class="portfolio-kicker">Projets & réalisations</span>
            <h2>Mes projets techniques en détail</h2>
            <p>
                Consultez mon e‑portfolio pour découvrir les travaux pratiques, projets de semestre
                et expérimentations qui illustrent ma progression.
            </p>
        </div>
        <a href="{{ path('mon_e_portfolio') }}" class="btn-primary-xl portfolio-btn">
            <i class="bi bi-collection"></i>
            Ouvrir l’e‑portfolio
        </a>
    </div>
</section>

    

