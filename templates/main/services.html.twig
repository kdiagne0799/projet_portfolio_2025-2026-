{% extends 'base.html.twig' %}

{% block title %}Services – Khadim Diagne{% endblock %}

{% block body %}
<section id="services-section" class="services-section">
    <h2 class="section-title services-title">Mes services & compétences</h2>

    <div class="services-intro">
        <p>
            Voici un aperçu des domaines sur lesquels je peux intervenir : réseaux, systèmes,
            développement web et cybersécurité, avec une approche sérieuse et orientée résultats.
        </p>
    </div>

    <div class="services-grid">
        <!-- Service 1 : Administration Réseau -->
        <article class="service-card">
            <div class="service-icon">
                <i class="bi bi-hdd-network"></i>
            </div>
            <h3>Administration réseau & internet</h3>
            <ul>
                <li>Interventions sur équipements réseaux et télécoms.</li>
                <li>Configuration LAN, VLAN, IP, switching et routage.</li>
                <li>Administration Linux / Windows et optimisation réseau.</li>
            </ul>
        </article>

        <!-- Service 2 : Connectivité & ToIP -->
        <article class="service-card">
            <div class="service-icon">
                <i class="bi bi-telephone-forward"></i>
            </div>
            <h3>Connectivité & ToIP</h3>
            <ul>
                <li>Déploiement câblage, fibre, Wi-Fi et VoIP.</li>
                <li>Optimisation de la qualité des appels et de la bande passante.</li>
                <li>Accompagnement des utilisateurs sur les outils de communication.</li>
            </ul>
        </article>

        <!-- Service 3 : Développement Informatique -->
        <article class="service-card">
            <div class="service-icon">
                <i class="bi bi-code-slash"></i>
            </div>
            <h3>Développement informatique & web</h3>
            <ul>
                <li>Création de sites et applications (HTML, CSS, PHP, Symfony).</li>
                <li>Gestion de bases de données et intégration Git/GitHub.</li>
                <li>Automatisation de tâches réseau et systèmes.</li>
            </ul>
        </article>

        <!-- Service 4 : Sécurité & Cybersécurité -->
        <article class="service-card">
            <div class="service-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h3>Sécurité & cybersécurité</h3>
            <ul>
                <li>Configuration sécurisée des équipements et serveurs.</li>
                <li>Firewall, ACL, chiffrement, premiers tests de sécurité.</li>
                <li>Sensibilisation et bonnes pratiques pour les utilisateurs.</li>
            </ul>
        </article>

        <!-- Service 5 : Virtualisation & Systèmes -->
        <article class="service-card">
            <div class="service-icon">
                <i class="bi bi-cloud"></i>
            </div>
            <h3>Virtualisation & administration système</h3>
            <ul>
                <li>Création et gestion de machines virtuelles.</li>
                <li>Configuration réseaux virtuels : NAT, bridge, host-only.</li>
                <li>Maintenance d’environnements virtuels et physiques.</li>
            </ul>
        </article>
    </div>

    <div class="services-footer">
        <a href="{{ path('contact') }}" class="btn-primary">
            <i class="bi bi-send-fill"></i>
            Discuter de mon projet
        </a>
        <a href="{{ path('accueil') }}" class="btn-ghost">
            <i class="bi bi-house-door"></i>
            Retour à l’accueil
        </a>
    </div>
</section>
{% endblock %}

{% block page_styles %}
.services-section {
    max-width: 1120px;
    margin: 0 auto;
}

.services-title {
    text-align: center;
    margin-bottom: 1.4rem;
    font-size: 1.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-main);
    position: relative;
}

.services-title::after {
    content: '';
    display: block;
    width: 80px;
    height: 3px;
    margin: 0.6rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #f97316, #fb923c);
}

.services-intro {
    max-width: 640px;
    margin: 0 auto 1.6rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.95rem;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.4rem;
}

.service-card {
    background: rgba(15, 23, 42, 0.96);
    border-radius: 18px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    padding: 1.3rem 1.2rem;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.9);
    transition: transform 0.18s ease-out, box-shadow 0.18s ease-out, border-color 0.18s ease-out;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 50px rgba(15, 23, 42, 0.95);
    border-color: rgba(249, 115, 22, 0.7);
}

.service-icon {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(249, 115, 22, 0.12);
    color: var(--accent);
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
}

.service-card h3 {
    font-size: 1.05rem;
    margin: 0;
    color: var(--text-main);
}

.service-card ul {
    list-style: none;
    padding-left: 0;
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
}

.service-card li {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.25rem;
}

.service-card li::before {
    content: '•';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
}

.services-footer {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 0.8rem;
}

/* Responsive */
@media (max-width: 700px) {
    .services-title {
        font-size: 1.4rem;
        letter-spacing: 0.12em;
    }
}
{% endblock %}
