{% block page_styles %}
.contact-section {
    max-width: 1000px;
    margin: 0 auto;
}

.contact-title {
    text-align: center;
    margin-bottom: 1.7rem;
    font-size: 1.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-main);
    position: relative;
}

.contact-title::after {
    content: '';
    display: block;
    width: 72px;
    height: 3px;
    margin: 0.6rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #f97316, #fb923c);
}

.contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr);
    gap: 1.8rem;
}

.contact-card {
    background: rgba(15, 23, 42, 0.96);
    border-radius: 18px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    padding: 1.4rem 1.3rem;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.9);
    transition: transform 0.18s ease-out, box-shadow 0.18s ease-out, border-color 0.18s ease-out;
}

.contact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 50px rgba(15, 23, 42, 0.95);
    border-color: rgba(249, 115, 22, 0.6);
}

.contact-subtitle {
    font-size: 1.1rem;
    margin-bottom: 0.9rem;
    color: var(--text-main);
}

.contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
}

.contact-list li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.45rem;
}

.contact-list i {
    color: var(--accent);
}

.contact-list a {
    color: var(--text-main);
    text-decoration: none;
    border-bottom: 1px dashed rgba(249, 115, 22, 0.6);
    padding-bottom: 1px;
    transition: color 0.18s ease-out, border-color 0.18s ease-out;
}

.contact-list a:hover {
    color: var(--accent);
    border-color: var(--accent);
}

.contact-form-card {
    background: rgba(15, 23, 42, 0.94);
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.4rem;
}

.contact-form input,
.contact-form textarea {
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    border: 1px solid rgba(148, 163, 184, 0.5);
    background: rgba(15, 23, 42, 0.9);
    color: var(--text-main);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.18s ease-out, box-shadow 0.18s ease-out, background 0.18s ease-out;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
    color: rgba(148, 163, 184, 0.8);
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(249, 115, 22, 0.35);
    background: rgba(15, 23, 42, 1);
}

.contact-note {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
}

.contact-back {
    margin-top: 1.8rem;
    text-align: center;
}

/* Responsive */
@media (max-width: 800px) {
    .contact-grid {
        grid-template-columns: minmax(0, 1fr);
    }

    .contact-title {
        font-size: 1.4rem;
        letter-spacing: 0.12em;
    }
}
{% endblock %}
